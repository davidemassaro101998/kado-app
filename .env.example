# GEMINI_API_KEY: Required. Your Google Gemini API key, used server-side
# by server.ts to call the Gemini models (recommendations, chat, TTS).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional. The port the Express server listens on.
# Railway (and most PaaS providers) inject this automatically — leave
# it unset in production and it will default to 3000 locally.
# PORT=3000

# APP_URL: Optional. Public URL where this app is hosted. Some
# platforms (e.g. AI Studio / Cloud Run) inject this automatically for
# self-referential links; not required for a standard Railway deploy.
# APP_URL="https://your-app-url.example.com"

# --- Amazon Associates tags (optional, client-side / Vite) ---
# Each variable overrides the built-in placeholder tag for that
# marketplace. Set these to your real Amazon Associates tracking IDs
# once you have them; any left unset fall back to the placeholder
# tags already defined in src/data/countries.ts. These are also read
# server-side (server.ts / paapi.ts) as the PartnerTag for real PA-API
# product lookups — same variables, no separate config needed.
# VITE_AMAZON_TAG_US=your-us-tag-20
# VITE_AMAZON_TAG_IT=your-it-tag-21
# VITE_AMAZON_TAG_UK=your-uk-tag-21
# VITE_AMAZON_TAG_DE=your-de-tag-21
# VITE_AMAZON_TAG_FR=your-fr-tag-21
# VITE_AMAZON_TAG_ES=your-es-tag-21
# VITE_AMAZON_TAG_CA=your-ca-tag-20
# VITE_AMAZON_TAG_JP=your-jp-tag-22

# --- Amazon Product Advertising API (optional, server-side) ---
# Leave both empty until Amazon approves your Associates account for
# PA-API access (requires qualifying sales first — see
# https://webservices.amazon.com/paapi5/documentation/). With these
# unset, the app runs exactly as it does today: Gemini-generated gift
# ideas linked to an Amazon search. Once both are set (together with a
# real VITE_AMAZON_TAG_* above for the relevant marketplace), real
# product data (ASIN, live price, real rating/reviews, real image)
# automatically replaces the AI estimate for gifts PA-API can match —
# no code changes needed, see paapi.ts.
# AMAZON_PAAPI_ACCESS_KEY=
# AMAZON_PAAPI_SECRET_KEY=
